# Copy to .env (gitignored) and fill in.

PORT=8787

# <Apple Team ID>.<bundle identifier>. The Team ID is in your Apple Developer account (Membership).
APP_ID=YOURTEAMID.com.narasimha.chainspeed

# Development builds attest in the "development" environment; App Store/TestFlight builds in "production".
# Development builds can load arbitrary JavaScript, so a development attestation says little about the
# data. Allow it only while testing, never for anything that produces evidence.
ATTEST_ENVIRONMENTS=development

# Privy dashboard > App settings. Also enable "Return user data in an identity token"
# (User management > Authentication > Advanced).
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The SpeedRegistry v2 address, and the key of the account set as its registrar.
# Use a dedicated key. It can register, replace and revoke any wallet's device key, so protect it.
REGISTRY_ADDRESS=
REGISTRAR_PRIVATE_KEY=
RPC_URL=https://testnet.hashio.io/api

DB_PATH=./data/devices.sqlite
