{
  "expo": {
    "name": "ChainSpeed",
    "slug": "chainspeed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.narasimha.chainspeed",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ChainSpeed needs location access to record your driving speed for legal protection against false speeding tickets.",
        "NSLocationWhenInUseUsageDescription": "ChainSpeed needs location access to record your driving speed for legal protection against false speeding tickets.",
        "NSLocationAlwaysUsageDescription": "ChainSpeed needs background location access to continuously record your driving speed even when the app is not active.",
        "NSMotionUsageDescription": "ChainSpeed uses motion sensors to verify and validate GPS speed readings for enhanced accuracy.",
        "UIBackgroundModes": ["location", "background-fetch", "background-processing"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "dev.privy.example",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "extra": {
      "privyAppId": "cmedwf4cd001vk10c4a8imp1r",
      "privyClientId": "client-WY6PoafcGy63fWj1FvUW979xKhxuZKp2KfErbdLHcfgDZ"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",

      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.5"
          },
          "android": {
            "compileSdkVersion": 35
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-location",
      "expo-sensors",
      "expo-task-manager",
      "expo-background-fetch"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
