{
  "expo": {
    "name": "ChainSpeed",
    "slug": "chainspeed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.narasimha.chainspeed",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "development"
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "ChainSpeed uses Face ID once at the start of each drive to unlock the key that signs your speed records.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ChainSpeed uses your location to record your driving speed in signed checkpoints.",
        "NSLocationWhenInUseUsageDescription": "ChainSpeed uses your location to record your driving speed in signed checkpoints.",
        "NSLocationAlwaysUsageDescription": "ChainSpeed uses your location to record your driving speed during a drive you start.",
        "NSMotionUsageDescription": "ChainSpeed reads motion sensors during a drive.",
        "UIBackgroundModes": ["location", "background-fetch", "background-processing"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "dev.privy.example",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "extra": {
      "privyAppId": "cmwjvk4g4005x0hli88aaghet",
      "privyClientId": "client-WY6fk6r7NX61xTAfnGVUvQJPucPDEAp1E6jmH7mHa5Wak"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",

      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.5"
          },
          "android": {
            "compileSdkVersion": 35
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-location",
      "expo-sensors",
      "expo-task-manager",
      "expo-background-fetch"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
