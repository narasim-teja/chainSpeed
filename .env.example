# Copy to .env.local (gitignored). EXPO_PUBLIC_* values are bundled into the app, so they are public.

# SpeedRegistry v2 address, printed by `bun run deploy:hedera-testnet` in contracts/.
EXPO_PUBLIC_SPEED_REGISTRY_ADDRESS=

# XPRewards v2 address (reads SpeedRegistry v2), printed by `bun run deploy:hedera-testnet-xp-rewards` in contracts/.
EXPO_PUBLIC_XP_REWARDS_ADDRESS=

# The device registrar (server/), reachable from the phone over HTTPS,
# e.g. a tunnel to your laptop: https://<name>.trycloudflare.com
EXPO_PUBLIC_REGISTRAR_URL=
